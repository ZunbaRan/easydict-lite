    "focused.api.channel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通道"
          }
        }
      }
    },
    "focused.api.compatibility_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave temperature off for models that do not support it. Reasoning content is hidden. Endpoints that return JSON instead of streaming are supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持温度参数的模型请关闭该选项。隐藏思考内容。支持不返回流式数据而返回 JSON 的接口。"
          }
        }
      }
    },
    "focused.api.compatible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-compatible API"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 兼容 API"
          }
        }
      }
    },
    "focused.api.connection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "focused.api.endpoint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint or base URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求地址或 Base URL"
          }
        }
      }
    },
    "focused.api.key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key"
          }
        }
      }
    },
    "focused.api.key_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are stored in Keychain. Click Save key after editing. A key may be omitted for a local API. Test connection sends only a small fixed sample."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在钥匙串中。编辑后点击保存密钥。本地 API 可以不填写密钥。测试连接仅发送固定的简短示例。"
          }
        }
      }
    },
    "focused.api.model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
