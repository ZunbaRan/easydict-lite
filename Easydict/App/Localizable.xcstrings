{
  "sourceLanguage": "en",
  "strings": {
    "focused.about.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse selection and explicit clipboard translation with OpenAI-compatible APIs and DeepSeek. No OCR, audio, dictionary imports, text replacement, or telemetry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 OpenAI 兼容 API 和 DeepSeek 进行鼠标划词与显式剪贴板翻译。不包含 OCR、音频、词典导入、文本替换或遥测。"
          }
        }
      }
    },
    "focused.about.license": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fork of Easydict by tisfeng and contributors. Licensed under GPL-3.0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 tisfeng 及贡献者的 Easydict 分支，采用 GPL-3.0 许可证。"
          }
        }
      }
    },
    "focused.action.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "focused.action.copy": {
      "localizations": {
        "en": {
          "stringUnit": {
