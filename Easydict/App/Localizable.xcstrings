    "focused.permissions.granted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission granted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授予辅助功能权限"
          }
        }
      }
    },
    "focused.permissions.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard Translation works without accessibility permission. No keyboard shortcuts, Copy simulation, or screen-recording permission are used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板翻译无需辅助功能权限。不使用全局快捷键、模拟复制或屏幕录制权限。"
          }
        }
      }
    },
    "focused.permissions.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "focused.permissions.recheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "focused.permissions.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission required for mouse selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标划词需要辅助功能权限"
          }
        }
      }
    },
    "focused.prompts.custom": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a custom prompt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自定义提示词"
          }
        }
      }
    },
    "focused.prompts.lookup_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word explanations are generated by your LLM. No dictionary database is queried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单词解释由您配置的 LLM 生成，不查询词典数据库。"
          }
        }
      }
    },
    "focused.prompts.retained_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in translation, word lookup, and sentence analysis prompts are retained. Switch modes in the result panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留内置翻译、查单词及句子分析提示词。可在结果面板切换模式。"
          }
