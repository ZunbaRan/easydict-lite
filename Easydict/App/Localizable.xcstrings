            "value": "剪切"
          }
        }
      }
    },
    "focused.edit.paste": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴"
          }
        }
      }
    },
    "focused.edit.select_all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全选"
          }
        }
      }
    },
    "focused.error.api_key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter and save a DeepSeek API key in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中填写并保存 DeepSeek API Key。"
          }
        }
      }
    },
    "focused.error.clipboard_empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard contains no plain text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板中没有纯文本。"
          }
        }
      }
    },
    "focused.error.empty_response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API returned no answer text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 未返回回答文本。"
          }
        }
      }
    },
    "focused.error.endpoint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an HTTPS API URL, or an HTTP URL on localhost for a local model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 HTTPS API 地址，或本机模型的 localhost HTTP 地址。"
          }
        }
      }
    },
    "focused.error.finish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model could not complete this text request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未能完成此文本请求。"
          }
        }
      }
    },
    "focused.error.incomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer is incomplete: the model reached its output limit or the stream ended early. The partial result is preserved; try a smaller passage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答不完整：模型达到输出上限或流式响应提前结束。已保留部分结果，请尝试较短的段落。"
          }
        }
      }
    },
    "focused.error.input_size": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text exceeds the 2 MiB input limit. Split it into smaller passages; nothing has been truncated or sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文本超过 2 MiB 输入上限。请分为较小的段落，原文未被截断或发送。"
          }
        }
      }
    },
    "focused.error.keychain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access the API key in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问钥匙串中的 API 密钥。"
          }
        }
      }
    },
    "focused.error.model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a model name in API Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 API 设置中填写模型名称。"
          }
        }
      }
    },
    "focused.error.response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API returned an invalid Chat Completions response."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 返回了无效的 Chat Completions 响应。"
          }
        }
      }
    },
    "focused.error.response_size": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API response exceeded the safety limit. Any received result is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 响应超过大小上限，已保留接收到的结果。"
          }
        }
      }
    },
    "focused.language.auto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No language filter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不过滤语言"
          }
        }
      }
    },
    "focused.language.classical": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classical Chinese"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文言文"
          }
        }
      }
    },
    "focused.language.detection_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses system language detection. Text in the first language is translated to the second; other text is translated to the first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用系统语种识别。第一语言的文本翻译为第二语言，其他文本翻译为第一语言。"
          }
        }
      }
    },
    "focused.language.first": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一语言"
          }
        }
      }
    },
    "focused.language.second": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Second language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二语言"
          }
        }
      }
    },
